# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to "production" on your cloud host (enables secure HTTPS-only cookies)
FLASK_ENV=production

# Only needed if frontend and backend are on different domains
# ALLOWED_ORIGINS=https://your-app.onrender.com

# Redis — used for cooldown tracking, rate limiting, risk scores
REDIS_URL=redis://default:password@host:port

# PostgreSQL — used for persistent storage
DATABASE_URL=postgresql://user:password@host:port/database

# Appwrite — cloud storage for violation clip uploads
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-api-key
APPWRITE_BUCKET_ID=your-bucket-id

# JWT — used for token-based auth
JWT_SECRET_KEY=change-me-to-another-random-string

# Proctor standalone service
PROCTOR_PORT=5001

# URL of the main Flask app (used by standalone proctor.py)
FLASK_API=http://localhost:5000
